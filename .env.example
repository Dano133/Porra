# === Firebase (cliente, públicas) ===
NEXT_PUBLIC_FIREBASE_API_KEY=tu-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tu-proyecto
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=tu-proyecto.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000:web:abcdef

# === URL pública ===
NEXT_PUBLIC_SITE_URL=https://tu-proyecto.web.app

# === Firebase Functions (configuradas con `firebase functions:config:set`) ===
# resend.api_key="re_xxx"
# email.from="Porra Mundial <noreply@tu-dominio.com>"
